# Telegram Bot API Token from @BotFather (Required)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Owner / Admin Telegram User ID (Required)
OWNER_ID=7394590844

# MongoDB Connection URI (Required)
MONGO_URI=mongodb://localhost:27017/stdrequestbot

# Database Name (Default: stdrequestbot)
DB_NAME=stdrequestbot

# Force Subscribe Channel Username without @ (Optional)
FORCE_SUB_CHANNEL=StdBots

# Log Channel ID to forward audit events (Optional, e.g. -1001234567890)
LOG_CHANNEL_ID=0

# Auto-Approve Delay in Seconds (0 = Instant)
APPROVAL_DELAY_SECONDS=0

# Application Environment (development / production)
ENV=production
